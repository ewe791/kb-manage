# ===== 应用 =====
APP_NAME=知识库 Agent
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/kb_agent.db
# 生产（配合 docker-compose.yml）：
# DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb_agent
REDIS_URL=redis://localhost:6379/0

# ===== 认证（务必替换为自己的随机串）=====
JWT_SECRET=please-change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== LLM（OpenAI 兼容）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== 向量 =====
# auto：优先 sentence-transformers；未安装时自动回退内置哈希向量
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_TOP_K=5
MIN_RELEVANCE=0.18
MIN_RELATIVE_SCORE=0.75

# ===== 业务 =====
FAQ_HIT_THRESHOLD=5
FAQ_SEMANTIC_THRESHOLD=0.85
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true
